<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:elevation="10dp"
        android:padding="5dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/lmain1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_item"
                        android:layout_width="70sp"
                        android:layout_height="70sp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="3dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="3dp"
                        android:layout_marginBottom="3dp"
                        android:src="@drawable/pizza" />


                    <ImageView
                        android:id="@+id/foodMark"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="19dp"
                        android:layout_marginRight="5dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/menuItemName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/concert_one"
                        android:text="Kachori"
                        android:textColor="@color/colorAccent"
                        android:textSize="18sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/menuItemCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/menuItemName"
                        android:layout_marginStart="11dp"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/concert_one"
                        android:text="Kolhapuri special"
                        android:textColor="@color/black_de"
                        android:textSize="15sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/menuItemPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/menuItemCategory"
                        android:layout_marginStart="11dp"
                        android:layout_marginTop="3dp"
                        android:layout_toEndOf="@+id/foodMark"
                        android:fontFamily="@font/concert_one"
                        android:text="₹ 23"
                        android:textColor="@color/colorAccent"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lmain1"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/addcart_bk"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_decrement"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@color/transparent"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/tv_quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:textSize="17sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_increment"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@color/transparent"
                        android:src="@drawable/ic_add" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_itemTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/concert_one"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tv_itemGST"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/concert_one"
                        android:text="GST : 18%"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>


                <!--            <com.cepheuen.elegantnumberbutton.view.ElegantNumberButton-->
                <!--                android:id="@+id/number_button2"-->
                <!--                android:layout_width="150dp"-->
                <!--                android:layout_height="60dp"-->
                <!--                android:padding="10dp"-->
                <!--                app:initialNumber="1"-->
                <!--                app:finalNumber="100"-->
                <!--                android:layout_centerVertical="true"-->
                <!--                app:textColor="@color/white" />-->

                <!--            <com.google.android.material.textview.MaterialTextView-->
                <!--                android:id="@+id/text_view"-->
                <!--                android:layout_width="wrap_content"-->
                <!--                android:layout_height="wrap_content"-->
                <!--                android:layout_below="@+id/number_button2"-->
                <!--                android:layout_centerInParent="true"-->
                <!--                android:text=""-->
                <!--                android:textSize="24sp"-->
                <!--                android:textStyle="bold"-->
                <!--                tools:ignore="NotSibling" />-->

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>