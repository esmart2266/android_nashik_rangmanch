                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/refund_datetime_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="4"
                                android:fontFamily="@font/opensans_regular"
                                android:text="Refund Datetime : "
                                android:textColor="@color/darker_gray_profile"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_refund_datetime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="7"
                                android:fontFamily="@font/secular_one_regular"
                                android:text=""
                                android:textColor="@color/black" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/paymentStatus_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="4"
                                android:fontFamily="@font/opensans_regular"
                                android:text="Payment Status : "
                                android:textColor="@color/darker_gray_profile"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_payment_Status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="7"
                                android:fontFamily="@font/secular_one_regular" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/cancellation_satus_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="5"
                                android:fontFamily="@font/opensans_regular"
                                android:text="Cancellation Status : "
                                android:textColor="@color/darker_gray_profile"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_cancellation_Status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="5"
                                android:fontFamily="@font/secular_one_regular"
                                android:text="Confiremed"
                                android:textColor="@color/blue" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="2"
                                android:gravity="center">

                                <ImageView
                                    android:id="@+id/iv_cancellation_details"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_margin="3dp"
                                    android:src="@drawable/cancellation_details" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/reschedule_satus_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="5"
                                android:fontFamily="@font/opensans_regular"
                                android:text="Reschedule Status : "
                                android:textColor="@color/darker_gray_profile"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_reschedule_Status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="5"
                                android:fontFamily="@font/secular_one_regular"
                                android:text="Confiremed"
                                android:textColor="@color/blue" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="2"
                                android:gravity="center">

                                <ImageView
                                    android:id="@+id/iv_reschedule_details"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_margin="3dp"
                                    android:src="@drawable/cancellation_details" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

