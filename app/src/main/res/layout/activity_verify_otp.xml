<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    tools:ignore="MissingPrefix">

    <include android:id="@+id/toolbar_container"
        layout="@layout/toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_container"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <com.rengwuxian.materialedittext.MaterialEditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="16dp"
            android:textSize="15sp"
            android:hint="Enter OTP sent on your email"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            app:met_baseColor="@color/font_black_0"
            app:met_floatingLabel="highlight"
            app:met_floatingLabelTextColor="@color/font_black_0"
            app:met_helperTextColor="@color/font_black_0"
            app:met_iconPadding="0dp"
            app:met_primaryColor="@color/font_black_0"
            app:met_textColor="@color/font_black_0"
            app:met_textColorHint="@color/font_black_3"
            app:met_underlineColor="@color/font_black_0" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/rect_round_colorprimary"
            android:text="SUBMIT"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>