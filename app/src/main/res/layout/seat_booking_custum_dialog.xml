<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="12dp"
    android:elevation="5dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    tools:context=".LoginActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border"
        android:layout_below="@+id/ll_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            android:paddingRight="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_margin="5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:id="@+id/ll_selectdate"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_gravity="center"
                        android:layout_height="30dp"
                        android:id="@+id/iv_date"
                        android:src="@drawable/date_picker"/>

                    <com.rengwuxian.materialedittext.MaterialEditText
                        android:id="@+id/et_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Date"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:drawableEnd="@drawable/selector_arrow_down"
                        android:maxLines="1"
                        android:focusable="false"
                        android:fontFamily="@font/opensans_regular"
                        android:paddingLeft="8dp"
                        android:paddingRight="24dp"
                        app:met_baseColor="@color/font_black_0"
                        app:met_floatingLabel="highlight"
                        app:met_helperTextColor="@color/font_black_0"
                        app:met_iconPadding="0dp"
                        app:met_primaryColor="@color/font_black_0"
                        app:met_textColor="@color/font_black_0"
                        app:met_textColorHint="@color/font_black_3"
                        app:met_underlineColor="@color/font_black_0" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_margin="5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:id="@+id/ll_selecttime"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_gravity="center"
                        android:layout_height="30dp"
                        android:id="@+id/iv_clok"
                        android:src="@drawable/clock"/>

                    <com.rengwuxian.materialedittext.MaterialEditText
                        android:id="@+id/et_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Time"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:drawableEnd="@drawable/selector_arrow_down"
                        android:maxLines="1"
                        android:focusable="false"
                        android:fontFamily="@font/opensans_regular"
                        android:paddingLeft="8dp"
                        android:paddingRight="24dp"
                        app:met_baseColor="@color/font_black_0"
                        app:met_floatingLabel="highlight"
                        app:met_helperTextColor="@color/font_black_0"
                        app:met_iconPadding="0dp"
                        app:met_primaryColor="@color/font_black_0"
                        app:met_textColor="@color/font_black_0"
                        app:met_textColorHint="@color/font_black_3"
                        app:met_underlineColor="@color/font_black_0" />


                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="12dp"
                android:layout_gravity="center"
                android:layout_marginRight="34dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rect_round_colorprimary"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />


                <Button
                    android:id="@+id/btnClosing"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/rect_round_colorprimary"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>
</androidx.cardview.widget.CardView>