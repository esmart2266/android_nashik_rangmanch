<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#E7F2EB">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Consulting Doctor : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConsultingDoctor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="7"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Visit Date : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVisitDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4.5"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Receipt ID : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceiptID"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3.5"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Bill Details : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBillDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="7"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Payable : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPayable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4.5"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Discount : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Received : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceived"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4.5"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:text="Pending : "
                        android:textColor="@color/font_black_2"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPending"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="4"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/font_black_2" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>