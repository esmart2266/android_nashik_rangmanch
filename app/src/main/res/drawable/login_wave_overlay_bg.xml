<?xml version="1.0" encoding="utf-8"?>
<!--
    login_wave_overlay_bg.xml
    Wave shape used as a STROKE/BORDER around the image view — not on top of it.
    Set this as android:background on the FrameLayout (view_header_bg),
    and place the ImageView INSIDE so the wave border frames the image.
    Place in: res/drawable/login_wave_overlay_bg.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Transparent fill so image shows fully -->
    <solid android:color="@android:color/transparent" />

    <!-- Blue wave border -->
    <stroke
        android:width="4dp"
        android:color="#1565C0" />

    <corners
        android:bottomLeftRadius="60dp"
        android:bottomRightRadius="60dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp" />

</shape>